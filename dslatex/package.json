{
  "name": "dslatex",
  "displayName": "dsLaTex",
  "description": "Render LaTeX in raw Python docstrings on hover.",
  "version": "0.0.1",
  "publisher": "TriHardIndustries",
  "license": "MIT",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "keywords": [
    "python",
    "latex",
    "math",
    "docstring",
    "hover"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "dsLaTex",
      "properties": {
        "dslatex.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable LaTeX rendering in Python docstring hovers."
        },
        "dslatex.strokeWidth": {
          "type": "number",
          "default": 18,
          "minimum": 0,
          "maximum": 50,
          "description": "Stroke width used when rendering LaTeX glyphs."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "@mathjax/mathjax-bbm-font-extension": "^4.1.3",
    "@mathjax/mathjax-bboldx-font-extension": "^4.1.3",
    "@mathjax/mathjax-dsfont-font-extension": "^4.1.3",
    "@mathjax/mathjax-mhchem-font-extension": "^4.1.3",
    "@mathjax/src": "^4.1.3"
  },
  "devDependencies": {
    "@types/vscode": "^1.134.0",
    "@types/node": "^22.0.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^6.0.0"
  }
}
